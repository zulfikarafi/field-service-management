generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  password    String

  reports     Report[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Report {
  id          String        @id @default(cuid())

  name        String

  description String

  status      ReportStatus  @default(PENDING)

  location    String?

  createdAt   DateTime      @default(now())

  updatedAt   DateTime      @updatedAt

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
