generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  PELAPOR
  APPROVER
}

model User {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  password    String
  role        UserRole    @default(PELAPOR)

  // Laporan yang dibuat oleh user (sebagai Pelapor)
  reports         Report[] @relation("ReportAuthor")

  // Laporan yang diputuskan (approve/reject) oleh user (sebagai Approver)
  decidedReports  Report[] @relation("ReportDecider")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Report {
  id          String        @id @default(cuid())

  name        String

  description String

  status      ReportStatus  @default(PENDING)

  location    String?

  createdAt   DateTime      @default(now())

  updatedAt   DateTime      @updatedAt

  // Pembuat laporan (Pelapor)
  userId      String
  user        User          @relation("ReportAuthor", fields: [userId], references: [id], onDelete: Cascade)

  // Riwayat persetujuan: siapa yang approve/reject dan kapan
  decidedById String?
  decidedBy   User?         @relation("ReportDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  @@index([userId])
  @@index([status])
  @@index([decidedById])
}
